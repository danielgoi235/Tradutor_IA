{
  "name": "tradutor-ia-real",
  "version": "1.0.0",
  "description": "Real-time voice translator for international calls using Twilio and Gemini API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build"
  },
  "dependencies": {
    "@google-cloud/speech": "^5.6.0",
    "@google-cloud/text-to-speech": "^4.2.0",
    "@google/generative-ai": "^0.3.0",
    "axios": "^1.6.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "next-auth": "^4.24.13",
    "redis": "^4.6.12",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "twilio": "^4.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.37",
    "@types/uuid": "^10.0.0",
    "@vercel/node": "^5.6.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
